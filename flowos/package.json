{
  "name": "flowos",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight FlowOS runtime skeleton with core FlowAgent building blocks.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node dist/test.js && node --test tests/worker-routes.test.cjs && npm run test:commercial-service",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:commercial-labels": "tsc -p tsconfig.commercial-labels.json && node --test tests/commercial-labels.test.cjs",
    "test:commercial-service": "npm run test:commercial-labels && node --test tests/MRL_CommercialService.test.cjs",
    "start:commercial-service": "tsc -p tsconfig.commercial-labels.json && node service/MRL_CommercialService.cjs",
    "test:worker": "npm run build && node --test tests/worker-routes.test.cjs"
  }
}
